# Copy to .env.local (or set in your Vercel project settings) once the room
# server is deployed with `npm run party:deploy`.
#
# The room server's address: host only, no https:// and no trailing slash.
# Leave it unset for local development (the game then uses port 8787 on the
# same machine, where `npm run party:dev` listens).
NEXT_PUBLIC_PARTY_HOST=letter-bridge-rooms.your-subdomain.workers.dev
