{
  // Type-checks the room server against Cloudflare's runtime (not the browser).
  // worker-configuration.d.ts is generated by `npm run party:types`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts", "../src/lib/game/**/*.ts", "../src/lib/multiplayer/**/*.ts"]
}
